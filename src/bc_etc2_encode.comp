    uint error=a.error+b.error,header=packEtc1(a,b,flip,false);
    uvec4 choicesA=halfSelectors(colors,a,4),choicesB=halfSelectors(colors,b,4);
    bool useT=false; uvec4 choicesT=uvec4(0u);
    if(error>guard) {
        // Chromatic BC palettes are poorly represented by scalar ETC1 modifiers.
        // Two bounded clustering updates and sixteen T palettes cover these
        // cases without paying for all ETC1 base/table/refinement combinations.
        ivec3 sum=ivec3(0);
        for(uint i=0u;i<colors.count;++i) sum+=colors.values[i]*int(colors.weights[i]);
        ivec3 mean=sum/int(count),ca=mean,cb=mean; int furthest=-1;
        for(uint i=0u;i<colors.count;++i) if(colors.weights[i]!=0u) {
            ivec3 d=colors.values[i]-mean; int gray=d.r+d.g+d.b;
            int e=int(rgbError(colors.values[i],mean))-gray*gray/3;
            if(e>furthest) { furthest=e; cb=colors.values[i]; }
        }
        for(uint iteration=0u;iteration<2u;++iteration) {
            ivec3 sa=ivec3(0),sb=ivec3(0); int na=0,nb=0;
            for(uint i=0u;i<colors.count;++i) if(colors.weights[i]!=0u) {
                int weight=int(colors.weights[i]);
                if(rgbError(colors.values[i],ca)<=rgbError(colors.values[i],cb)) { sa+=colors.values[i]*weight; na+=weight; }
                else { sb+=colors.values[i]*weight; nb+=weight; }
