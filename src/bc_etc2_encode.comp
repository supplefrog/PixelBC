// EAC8 uses a big-endian 48-bit stream in column-major order, unlike the BC source.
uvec2 packAlpha(int base,uint table,uint multiplier,uint selectors[16]) {
    uint high=(uint(base)<<24u)|(multiplier<<20u)|(table<<16u),low=0u;
    for(uint p=0u;p<16u;++p) {
        uint i=(p%4u)*4u+p/4u,shift=45u-i*3u,s=selectors[p];
        if(shift>=32u) high|=s<<(shift-32u);
        else { low|=s<<shift; if(shift>29u) high|=s>>(32u-shift); }
    }
    return uvec2(byteSwap(high),byteSwap(low));
}
#ifndef PVB_ETC_BC1_ONLY
uvec2 alphaSelectors(AlphaSource alphas,int base,uint table,uint multiplier) {
    int palette[8]; uvec2 choices=uvec2(0u); uint selectors[16];
    for(uint k=0u;k<8u;++k) palette[k]=clamp(base+int(multiplier)*alphaModifiers[table*8u+k],0,255);
    for(uint i=0u;i<alphas.count;++i) {
        uint lowest=0xffffffffu,chosen=0u;
        for(uint k=0u;k<8u;++k) {
            int d=alphas.values[i]-palette[k]; uint e=uint(d*d);
            if(e<lowest) { lowest=e; chosen=k; }
        }
        choices[i/8u]|=chosen<<((i%8u)*4u);
    }
    for(uint p=0u;p<16u;++p) {
        uint i=(alphas.indices[p/8u]>>((p%8u)*4u))&15u;
        selectors[p]=(choices[i/8u]>>((i%8u)*4u))&15u;
    }
    return packAlpha(base,table,multiplier,selectors);
}
#ifndef PVB_ETC_BC3_ONLY
uvec2 encodeAlphaWeighted(AlphaSource alphas) {
    int minimum=255,maximum=0,count=alphas.texels;
    for(uint i=0u;i<alphas.count;++i) { minimum=min(minimum,alphas.values[i]); maximum=max(maximum,alphas.values[i]); }
    uint selectors[16];
    if(minimum==maximum) {
        // The specification forbids multiplier zero in an encoder. Table13 has a
        // zero modifier at selector4, so every constant 8-bit alpha is exact.
        for(uint p=0u;p<16u;++p) selectors[p]=4u;
