// Bounded BC3 recovery. Every seed is constrained to represent genuine 0/255.
// Three distribution-derived seeds and one residual update cover shifted/skewed
// palettes without the previous weighted search plus all-multiplier wide chain.
// At most 16 tables * 6 multipliers * 3 seeds * 2 trials = 576 palettes.
uvec2 encodeAlphaRecovery(AlphaSource alphas,int minimum,int maximum) {
    const uint tables[16]=uint[16](2u,0u,3u,8u,11u,13u,1u,4u,5u,6u,7u,9u,10u,12u,14u,15u);
    const int offsets[5]=int[5](0,1,-1,2,-2);
    int sum=0,interiorMinimum=255,interiorMaximum=0;
    for(uint i=0u;i<alphas.count;++i) {
        int value=alphas.values[i]; sum+=value*int(alphas.weights[i]);
        if(value>0 && value<255) { interiorMinimum=min(interiorMinimum,value); interiorMaximum=max(interiorMaximum,value); }
    }
    int mean=(sum+alphas.texels/2)/alphas.texels;
    if(interiorMinimum>interiorMaximum) { interiorMinimum=minimum; interiorMaximum=maximum; }
    uint bestError=0xffffffffu,bestPeak=0xffffffffu,bestTable=0u,bestMultiplier=1u; int bestBase=0;
    uint rmsGuard=uint(alphas.texels)*49u;
    for(uint step=0u;step<16u;++step) {
        uint table=tables[step];
        int low=alphaModifiers[table*8u+3u],high=alphaModifiers[table*8u+7u],span=high-low;
        int center=clamp((maximum-minimum+span/2)/span,1,15);
        int interiorSpan=alphaModifiers[table*8u+6u]-alphaModifiers[table*8u+2u];
        int interiorCenter=clamp((interiorMaximum-interiorMinimum+interiorSpan/2)/interiorSpan,1,15);
        for(uint offset=0u;offset<6u;++offset) {
            int multiplier=offset<5u ? center+offsets[offset] : interiorCenter;
            if(offset==5u && abs(interiorCenter-center)<=2) continue;
            if(multiplier<1 || multiplier>15) continue;
            int lower=maximum==255 ? max(0,255-high*multiplier) : 0;
            int upper=minimum==0 ? min(255,-low*multiplier) : 255;
            if(lower>upper) continue;
            int seeds[3]=int[3](
                clamp((minimum+maximum-(low+high)*multiplier+1)/2,lower,upper),
                clamp(mean,lower,upper),
                clamp((interiorMinimum+interiorMaximum-(alphaModifiers[table*8u+2u]+alphaModifiers[table*8u+6u])*multiplier+1)/2,lower,upper));
            for(uint seed=0u;seed<3u;++seed) {
                if((seed>0u && seeds[seed]==seeds[0]) || (seed==2u && seeds[seed]==seeds[1])) continue;
                int base=seeds[seed];
                for(uint trial=0u;trial<2u;++trial) {
                    int palette[8],residual=0; uint error=0u,peak=0u;
                    for(uint k=0u;k<8u;++k) palette[k]=clamp(base+multiplier*alphaModifiers[table*8u+k],0,255);
                    for(uint i=0u;i<alphas.count;++i) {
                        uint lowest=0xffffffffu; int chosen=0;
                        for(uint k=0u;k<8u;++k) {
                            int d=alphas.values[i]-palette[k]; uint e=uint(d*d);
                            if(e<lowest) { lowest=e; chosen=palette[k]; }
                        }
                        error+=lowest*alphas.weights[i]; peak=max(peak,lowest);
                        residual+=(alphas.values[i]-chosen)*int(alphas.weights[i]);
                    }
                    // One-level margin for independently truncated BC source.
                    if(peak<=225u && error<=rmsGuard) return alphaSelectors(alphas,base,table,uint(multiplier));
                    bool fits=peak<=225u,bestFits=bestPeak<=225u;
                    bool better=(fits && !bestFits) ||
                        (fits && bestFits && error<bestError) ||
                        (!fits && !bestFits && (peak<bestPeak || (peak==bestPeak && error<bestError)));
                    if(better) { bestError=error; bestPeak=peak; bestBase=base; bestTable=table; bestMultiplier=uint(multiplier); }
                    int next=clamp(base+int(floor(float(residual)/float(alphas.texels)+0.5)),lower,upper);
                    if(next==base) break;
                    base=next;
                }
            }
        }
    }
    // This remains a bounded heuristic; callers must validate original gates.
    return alphaSelectors(alphas,bestBase,bestTable,bestMultiplier);
}

uvec2 encodeAlpha(AlphaSource alphas) {
    int minimum=255,maximum=0;
    for(uint i=0u;i<alphas.count;++i) { minimum=min(minimum,alphas.values[i]); maximum=max(maximum,alphas.values[i]); }
    if(minimum==maximum) return alphaSelectors(alphas,minimum,13u,1u);
    // Native BC1 binary coverage has an exact legal EAC representation.
    if(alphas.count==2u && minimum==0 && maximum==255) return alphaSelectors(alphas,135,0u,9u);
    // Basis pack_eac's bounded range-derived four-table fit, altered for
    // weighted BC values and exact endpoints. Accept on absolute and RMS error,
    // rather than assuming an SSE optimum satisfies the independent gates.
    const uint tables[4]=uint[4](2u,8u,11u,13u);
    uint bestError=0xffffffffu,bestTable=0u,bestMultiplier=1u; int bestBase=0;
#ifdef PVB_ETC_BC3_ONLY
    const uint guard=225u;
#else
    uint guard=pc.format>=137u ? 225u : 256u;
#endif
    uint rmsGuard=uint(alphas.texels)*49u;
    for(uint trial=0u;trial<4u;++trial) {
        uint table=tables[trial];
        int low=alphaModifiers[table*8u+3u],high=alphaModifiers[table*8u+7u],span=high-low;
        int multiplier=clamp((maximum-minimum+span/2)/span,1,15);
        if(minimum==0 && maximum==255) multiplier=max(multiplier,(255+span-1)/span);
        int lower=maximum==255 ? max(0,255-high*multiplier) : 0;
        int upper=minimum==0 ? min(255,-low*multiplier) : 255;
        if(lower>upper) continue;
        int base=clamp(minimum+((maximum-minimum)*(-low)+span/2)/span,lower,upper);
        int palette[8]; uint error=0u,peak=0u;
        for(uint k=0u;k<8u;++k) palette[k]=clamp(base+multiplier*alphaModifiers[table*8u+k],0,255);
        for(uint i=0u;i<alphas.count;++i) {
            uint lowest=0xffffffffu;
            for(uint k=0u;k<8u;++k) { int d=alphas.values[i]-palette[k]; lowest=min(lowest,uint(d*d)); }
            error+=lowest*alphas.weights[i]; peak=max(peak,lowest);
        }
        if(peak<=guard && error<=rmsGuard && error<bestError) {
            bestError=error; bestBase=base; bestTable=table; bestMultiplier=uint(multiplier);
        }
    }
    if(bestError!=0xffffffffu) return alphaSelectors(alphas,bestBase,bestTable,bestMultiplier);
#ifdef PVB_ETC_BC3_ONLY
    return encodeAlphaRecovery(alphas,minimum,maximum);
#else
    return pc.format>=137u ? encodeAlphaRecovery(alphas,minimum,maximum) : encodeAlphaWeighted(alphas);
#endif
}

