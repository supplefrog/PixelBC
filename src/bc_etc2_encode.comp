void main() {
    uvec3 q=gl_GlobalInvocationID;
    uint blocksX=(pc.width+3u)/4u,blocksY=(pc.height+3u)/4u;
    if(q.x>=blocksX || q.y>=blocksY || q.z>=pc.layers) return;
#ifdef PVB_ETC_BC1_ONLY
    if(pc.format<131u || pc.format>134u) return;
    const bool bc1=true; bool withAlpha=pc.format>=133u;
#elif defined(PVB_ETC_BC3_ONLY)
    if(pc.format<137u || pc.format>138u) return;
    const bool bc1=false,withAlpha=true;
#else
    if(pc.format<131u || pc.format>138u) return;
    bool bc1=pc.format<=134u,withAlpha=pc.format>=133u;
#endif
    uint wordsPerBlock=bc1 ? 2u : 4u;
    uint source=((q.z*pc.blocksHeight+q.y)*pc.blocksRow+q.x)*wordsPerBlock;
    uvec2 first=uvec2(src.words[source],src.words[source+1u]);
    uvec2 colorBlock=bc1 ? first : uvec2(src.words[source+2u],src.words[source+3u]);
    uint validWidth=min(4u,pc.width-q.x*4u),validHeight=min(4u,pc.height-q.y*4u);
    uvec2 rgb;
#ifdef PVB_ETC_BC1_ONLY
    uint opaqueMask=0u;
#endif
    {
        ColorSource colors; colors.count=0u; colors.indices=0u; colors.visibleTexels=0u; colors.weights=uvec4(0u);
        for(uint i=0u;i<4u;++i) colors.halfWeights[i]=uvec4(0u);
        for(uint y=0u;y<4u;++y) for(uint x=0u;x<4u;++x) {
            uint p=y*4u+x,clamped=min(y,validHeight-1u)*4u+min(x,validWidth-1u);
            uvec4 decoded=bcColor(colorBlock,clamped,!bc1,!withAlpha);
#ifdef PVB_ETC_BC1_ONLY
            if(decoded.a!=0u) opaqueMask|=1u<<p;
#endif
            ivec3 value=ivec3(decoded.rgb); uint i=0u;
            while(i<colors.count && any(notEqual(colors.values[i],value))) ++i;
            if(i==colors.count) { colors.values[i]=value; ++colors.count; }
            colors.indices|=i<<(p*2u);
            if(x<validWidth && y<validHeight) {
                ++colors.weights[i]; ++colors.halfWeights[x/2u][i]; ++colors.halfWeights[2u+y/2u][i];
#ifdef PVB_ETC_BC1_ONLY
                uint alpha=decoded.a;
#elif defined(PVB_ETC_BC3_ONLY)
                uint alpha=bcAlphaFloor(first,clamped);
#else
                uint alpha=bc1 ? decoded.a : (pc.format<=136u ? ((first[clamped/8u]>>((clamped%8u)*4u))&15u)*17u : bcAlphaFloor(first,clamped));
#endif
                colors.visibleTexels+=alpha!=0u ? 1u : 0u;
            }
        }
#ifdef PVB_ETC_BC1_ONLY
        rgb=encodeRgbWeighted(colors);
#else
        rgb=encodeRgb(colors);
#endif
    }
    uint target=((q.z*blocksY+q.y)*blocksX+q.x)*(withAlpha ? 4u : 2u);
    if(withAlpha) {
#ifdef PVB_ETC_BC1_ONLY
        uint selectors[16];
        for(uint p=0u;p<16u;++p) selectors[p]=((opaqueMask>>p)&1u)!=0u ? 7u : 3u;
        uvec2 alpha=packAlpha(135,0u,9u,selectors);
#else
        AlphaSource alphas; alphas.count=0u; alphas.indices=uvec2(0u); alphas.texels=0;
        for(uint i=0u;i<PVB_ALPHA_VALUES;++i) alphas.weights[i]=0u;
        for(uint y=0u;y<4u;++y) for(uint x=0u;x<4u;++x) {
            uint p=y*4u+x,clamped=min(y,validHeight-1u)*4u+min(x,validWidth-1u);
            int value;
#ifdef PVB_ETC_BC3_ONLY
            value=int(bcAlpha(first,clamped));
#else
            if(bc1) value=bcColor(colorBlock,clamped,false,false).a==0u ? 0 : 255;
            else value=pc.format<=136u ? int(((first[clamped/8u]>>((clamped%8u)*4u))&15u)*17u) : int(bcAlpha(first,clamped));
#endif
            uint i=0u;
            while(i<alphas.count && alphas.values[i]!=value) ++i;
            if(i==alphas.count) { alphas.values[i]=value; ++alphas.count; }
            alphas.indices[p/8u]|=i<<((p%8u)*4u);
            if(x<validWidth && y<validHeight) { ++alphas.weights[i]; ++alphas.texels; }
        }
        uvec2 alpha=encodeAlpha(alphas);
#endif
        dst.words[target]=alpha.x; dst.words[target+1u]=alpha.y; target+=2u;
    }
    dst.words[target]=rgb.x; dst.words[target+1u]=rgb.y;
}
