            int upper=minimum==0 ? min(255,-lowModifier*multiplier) : 255;
            if(lower>upper) continue;
            int base=clamp((minimum+maximum-(lowModifier+highModifier)*multiplier+1)/2,lower,upper);
            for(uint trial=0u;trial<3u;++trial) {
                uint error=0u,peak=0u; int residual=0,negativeResidual=255,positiveResidual=-255;
                int palette[8];
                for(uint k=0u;k<8u;++k) palette[k]=clamp(base+multiplier*alphaModifiers[t*8u+k],0,255);
                for(uint i=0u;i<alphas.count;++i) {
                    uint lowest=0xffffffffu; int chosenAlpha=0;
                    for(uint k=0u;k<8u;++k) {
                        int d=alphas.values[i]-palette[k]; uint e=uint(d*d);
                        if(e<lowest) { lowest=e; chosenAlpha=palette[k]; }
                    }
                    error+=lowest*alphas.weights[i]; peak=max(peak,lowest);
                    int d=alphas.values[i]-chosenAlpha;
                    residual+=d*int(alphas.weights[i]);
                    negativeResidual=min(negativeResidual,d); positiveResidual=max(positiveResidual,d);
                }
                // Prefer candidates within the alpha guard before minimizing SSE.
                // If none meet that guard, minimize the maximum error first.
                // A full BC2 0,17,...255 ramp with exact endpoints needs at least
                // 17 levels: eight EAC palette values cannot cover it within 16.
                bool fits=peak<=guard,bestFits=bestPeak<=guard;
                bool better=(fits && !bestFits) ||
                    (fits && bestFits && error<bestError) ||
                    (!fits && !bestFits && (peak<bestPeak || (peak==bestPeak && error<bestError)));
                if(better) { bestError=error; bestPeak=peak; bestBase=base; bestTable=t; bestMultiplier=uint(multiplier); }
                if(bestError==0u) return alphaSelectors(alphas,bestBase,bestTable,bestMultiplier);
                if(trial==2u || (trial==1u && bestPeak<=guard)) break;
                // First refine squared error. If the guard remains unmet, one
                // additional refinement balances the worst positive/negative errors.
                int shift=trial==0u ? int(floor(float(residual)/float(count)+0.5)) :
                    int(floor(float(negativeResidual+positiveResidual)*0.5+0.5));
                int next=clamp(base+shift,lower,upper);
                if(next==base && (trial!=0u || bestPeak<=guard)) break;
                base=next;
            }
        }
    }
    return alphaSelectors(alphas,bestBase,bestTable,bestMultiplier);
}

