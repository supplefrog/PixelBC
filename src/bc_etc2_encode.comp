}
uvec2 encodeRgb(ColorSource colors) {
    uint count=colors.weights.x+colors.weights.y+colors.weights.z+colors.weights.w;
    // A per-block bound is deliberately stronger than the corpus RMSE32 gate.
    // Reserve one byte level for independent BC endpoint expansion differences.
    uint guard=(colors.visibleTexels==0u ? count : colors.visibleTexels)*3u*31u*31u;
    float scores[2]=float[2](0.0,0.0);
    for(uint region=0u;region<4u;++region) {
        uvec4 weights=colors.halfWeights[region]; ivec3 sum=ivec3(0); uint squareSum=0u,n=0u;
        for(uint i=0u;i<colors.count;++i) {
            sum+=colors.values[i]*int(weights[i]); n+=weights[i];
