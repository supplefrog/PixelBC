// The common path scores one orientation and one mean-derived base per half.
// RGB variance chooses the orientation without fitting both orientations.
// One refinement of the winning table corrects modifier/quantization bias.
Fit fitHalfQuick(ColorSource colors,uint flip,uint region) {
    uvec4 weights=colors.halfWeights[flip*2u+region];
    ivec3 sum=ivec3(0); int count=0;
    for(uint i=0u;i<colors.count;++i) { sum+=colors.values[i]*int(weights[i]); count+=int(weights[i]); }
    ivec3 mean=count==0 ? colors.values[0] : (sum+count/2)/count;
    Fit best; best.q=quantize(mean,4); best.table=0u; best.error=0xffffffffu;
    ivec3 base=expandBase(best.q,4),bestResidual=ivec3(0);
    for(uint t=0u;t<8u;++t) {
        ivec3 palette[4],residual=ivec3(0); uint error=0u;
        for(uint k=0u;k<4u;++k) palette[k]=clamp(base+rgbModifiers[t][k],ivec3(0),ivec3(255));
        for(uint i=0u;i<colors.count;++i) if(weights[i]!=0u) {
            uint lowest=0xffffffffu; ivec3 chosen=base;
            for(uint k=0u;k<4u;++k) {
                uint e=rgbError(colors.values[i],palette[k]);
                if(e<lowest) { lowest=e; chosen=palette[k]; }
            }
            error+=lowest*weights[i]; residual+=(colors.values[i]-chosen)*int(weights[i]);
        }
        if(error<best.error) { best.error=error; best.table=t; bestResidual=residual; }
    }
    if(count!=0) {
        ivec3 q=quantize(clamp(base+ivec3(floor(vec3(bestResidual)/float(count)+0.5)),ivec3(0),ivec3(255)),4);
        if(any(notEqual(q,best.q))) {
            ivec3 palette[4]; uint error=0u;
            for(uint k=0u;k<4u;++k) palette[k]=clamp(expandBase(q,4)+rgbModifiers[best.table][k],ivec3(0),ivec3(255));
            for(uint i=0u;i<colors.count;++i) if(weights[i]!=0u) {
                uint lowest=0xffffffffu;
                for(uint k=0u;k<4u;++k) lowest=min(lowest,rgbError(colors.values[i],palette[k]));
                error+=lowest*weights[i];
            }
            if(error<best.error) { best.q=q; best.error=error; }
        }
    }
